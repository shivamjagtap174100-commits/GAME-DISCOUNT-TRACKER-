# ==============================================================================
# GAME DISCOUNT TRACKER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# In Vercel, configure these under: Project Settings -> Environment Variables
# ==============================================================================

# Application URL (Production or Local)
NEXT_PUBLIC_APP_URL=https://game-deal-tracker-vert.vercel.app

# Target Market & Currency (Standard: India / INR)
DEFAULT_REGION=IN
DEFAULT_CURRENCY=INR

# Vercel Cron Security Secret (MANDATORY FOR PRODUCTION CRON JOBS)
# Vercel automatically passes this in 'Authorization: Bearer <CRON_SECRET>' on every cron trigger
CRON_SECRET=your_long_random_cron_secret_min_32_chars

# Admin Dashboard Access Key (Required to trigger manual refreshes or view audit logs)
ADMIN_SECRET_KEY=your_secure_admin_password_or_token

# ==============================================================================
# SUPABASE POSTGRESQL CONFIGURATION (Optional - for persistent cloud storage)
# Found in: Supabase Dashboard -> Project Settings -> API & Database
# ==============================================================================
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==============================================================================
# SYNC & PROVIDER SETTINGS
# ==============================================================================
DATA_SOURCE_CACHE_TTL_MINUTES=30
SYNC_BATCH_SIZE=40
